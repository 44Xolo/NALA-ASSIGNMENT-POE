rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        (request.auth.token.firebase.sign_in_provider == 'phone' && request.auth.token.phone_number is string)
      );
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'role',
        'restaurant',
        'specialty',
        'yearsExperience',
        'bio',
        'contactEmail',
        'contactPhone',
        'authProvider',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'role',
        'restaurant',
        'specialty',
        'yearsExperience',
        'bio',
        'contactEmail',
        'contactPhone',
        'authProvider',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string
      && isValidId(data.uid)
      && data.uid == request.auth.uid
      && data.uid == userId
      && data.displayName is string
      && data.displayName.size() >= 1
      && data.displayName.size() <= 80
      && data.role is string
      && data.role.size() <= 60
      && data.restaurant is string
      && data.restaurant.size() <= 80
      && data.specialty is string
      && data.specialty.size() <= 80
      && data.yearsExperience is int
      && data.yearsExperience >= 0
      && data.yearsExperience <= 80
      && data.bio is string
      && data.bio.size() <= 300
      && data.contactEmail is string
      && data.contactEmail.size() <= 120
      && data.contactPhone is string
      && data.contactPhone.size() <= 32
      && data.authProvider in ['google', 'phone', 'email']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidOrderItem(item) {
      return item is map
        && item.keys().hasAll(['menuItemId', 'name', 'course', 'unitPrice', 'quantity', 'lineTotal'])
        && item.keys().hasOnly(['menuItemId', 'name', 'course', 'unitPrice', 'quantity', 'lineTotal'])
        && item.menuItemId is string
        && item.menuItemId.size() >= 1
        && item.menuItemId.size() <= 128
        && item.name is string
        && item.name.size() >= 1
        && item.name.size() <= 100
        && item.course in ['Starter', 'Main', 'Dessert', 'Drink']
        && item.unitPrice is number
        && item.unitPrice > 0
        && item.unitPrice <= 100000
        && item.quantity is int
        && item.quantity >= 1
        && item.quantity <= 20
        && item.lineTotal is number
        && item.lineTotal > 0
        && item.lineTotal <= 2000000;
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll([
        'id',
        'orderNumber',
        'userId',
        'customerName',
        'customerPhone',
        'fulfillment',
        'tableOrAddress',
        'notes',
        'paymentMethod',
        'paymentLast4',
        'paymentStatus',
        'status',
        'items',
        'subtotal',
        'serviceFee',
        'tip',
        'total',
        'createdAtMs',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'orderNumber',
        'userId',
        'customerName',
        'customerPhone',
        'fulfillment',
        'tableOrAddress',
        'notes',
        'paymentMethod',
        'paymentLast4',
        'paymentStatus',
        'status',
        'items',
        'subtotal',
        'serviceFee',
        'tip',
        'total',
        'createdAtMs',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.id)
      && data.id == orderId
      && data.orderNumber is string
      && data.orderNumber.size() >= 4
      && data.orderNumber.size() <= 24
      && isValidId(data.userId)
      && data.userId == request.auth.uid
      && data.customerName is string
      && data.customerName.size() >= 1
      && data.customerName.size() <= 80
      && data.customerPhone is string
      && data.customerPhone.size() <= 32
      && data.fulfillment in ['dine-in', 'collection', 'delivery']
      && data.tableOrAddress is string
      && data.tableOrAddress.size() >= 1
      && data.tableOrAddress.size() <= 120
      && data.notes is string
      && data.notes.size() <= 200
      && data.paymentMethod in ['card', 'instant-eft', 'cash-on-pickup']
      && data.paymentLast4 is string
      && data.paymentLast4.size() >= 1
      && data.paymentLast4.size() <= 16
      && data.paymentStatus in ['paid', 'pending_collection']
      && data.status in ['paid', 'preparing', 'ready', 'completed']
      && data.items is list
      && data.items.size() >= 1
      && data.items.size() <= 25
      && isValidOrderItem(data.items[0])
      && data.subtotal is number
      && data.subtotal > 0
      && data.subtotal <= 1000000
      && data.serviceFee is number
      && data.serviceFee >= 0
      && data.serviceFee <= 100000
      && data.tip is number
      && data.tip >= 0
      && data.tip <= 500000
      && data.total is number
      && data.total > 0
      && data.total <= 1600000
      && data.createdAtMs is int
      && data.createdAtMs > 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isVerifiedOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().authProvider == existing().authProvider
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'role',
          'restaurant',
          'specialty',
          'yearsExperience',
          'bio',
          'contactEmail',
          'contactPhone',
          'updatedAt'
        ]);
      allow delete: if isVerifiedOwner(userId) && isValidId(userId);
    }

    match /orders/{orderId} {
      allow get: if isVerifiedUser() && isValidId(orderId) && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming(), orderId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(orderId)
        && existing().userId == request.auth.uid
        && existing().status != 'completed'
        && isValidOrder(incoming(), orderId)
        && incoming().id == existing().id
        && incoming().orderNumber == existing().orderNumber
        && incoming().userId == existing().userId
        && incoming().items == existing().items
        && incoming().subtotal == existing().subtotal
        && incoming().serviceFee == existing().serviceFee
        && incoming().tip == existing().tip
        && incoming().total == existing().total
        && incoming().paymentMethod == existing().paymentMethod
        && incoming().paymentLast4 == existing().paymentLast4
        && incoming().createdAtMs == existing().createdAtMs
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'paymentStatus',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
